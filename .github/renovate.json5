{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    // Actions are already SHA-pinned with # vX.Y.Z comments; keep the digest and comment in sync.
    "helpers:pinGitHubActionDigests",
  ],

  // release-please owns commit/PR wording, so match its conventional-commit types.
  semanticCommitType: "fix",
  commitMessageLowerCase: "auto",

  // config:recommended ignores **/test/**, which would hide test/testimage/testimage.go from the
  // Technitium image manager below. Same list as :ignoreModulesAndTests minus **/test/**.
  ignorePaths: [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/tests/**",
    "**/__fixtures__/**",
  ],

  labels: ["dependencies"],
  rangeStrategy: "bump",

  // Batch runs into a weekly window to cut PR churn. This only limits when branches are created;
  // automerge happens whenever CI goes green.
  schedule: ["* * * * 0"],

  // Supply-chain cooldown: a release must be 7 days old before Renovate proposes it. With strict
  // filtering no branch or PR exists until the age check passes, so platform automerge (enqueued at
  // PR creation) can never merge a release younger than this. Releases without a timestamp are held
  // rather than waved through. Both settings are Renovate >= 42 defaults; set here to pin intent.
  minimumReleaseAge: "7 days",
  internalChecksFilter: "strict",
  minimumReleaseAgeBehaviour: "timestamp-required",

  // GitHub native automerge, squash only (the only method the repo allows). The main ruleset's
  // required status checks are what stop a PR merging before CI passes.
  platformAutomerge: true,
  automergeType: "pr",
  automergeStrategy: "squash",

  // Later rules override earlier ones, so the automerge default comes first and the opt-outs after.
  // A grouped PR automerges only if every update in it is allowed to.
  packageRules: [
    {
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest"],
      automerge: true,
    },
    // Go module patches are safe to batch and automerge. Minors stay manual: most modules here are
    // v0.x, where a minor bump is allowed to break the API.
    {
      matchManagers: ["gomod"],
      matchUpdateTypes: ["patch"],
      groupName: "go dependencies (patch)",
    },
    {
      matchManagers: ["gomod"],
      matchUpdateTypes: ["minor"],
      groupName: "go dependencies (minor)",
      automerge: false,
    },
    // k8s.io/* and sigs.k8s.io/* release in lockstep against a Kubernetes minor; bumping them
    // individually produces incompatible go.mod graphs. Must come after the go dependency groups
    // or their groupName wins. Kept manual: a minor here is a new Kubernetes minor.
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["k8s.io/**", "sigs.k8s.io/**"],
      groupName: "kubernetes packages",
      automerge: false,
    },
    // One PR for all GitHub Actions bumps instead of one per action.
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
    },
    // go.mod pins the toolchain; treat it as a deliberate, separate change.
    {
      matchManagers: ["gomod"],
      matchDepTypes: ["golang"],
      groupName: "go toolchain",
      automerge: false,
    },
    // A new Technitium server release can change API behaviour the operator relies on, so the
    // e2e suite must pass before this merges. Never automerge; the label makes it easy to spot.
    {
      matchDepNames: ["technitium/dns-server"],
      groupName: "technitium dns-server",
      automerge: false,
      addLabels: ["technitium-image"],
    },
    // Chart version/appVersion carry x-release-please-version markers; Renovate must not touch them.
    {
      matchFileNames: ["charts/technitium-operator/Chart.yaml"],
      enabled: false,
    },
  ],

  // flake.lock refresh: pin nixpkgs/flake-utils inputs on a schedule. Lock file maintenance has no
  // release timestamp, so minimumReleaseAge cannot gate it; it stays manual (automerge defaults off).
  nix: { enabled: true },
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am on sunday"],
  },

  // Tool versions pinned as just variables. Track upstream releases without editing the justfile.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^justfile$/"],
      matchStrings: ['kustomize_version := "(?<currentValue>v[^"]+)"'],
      datasourceTemplate: "github-releases",
      depNameTemplate: "kubernetes-sigs/kustomize",
      extractVersionTemplate: "^kustomize/(?<version>.+)$",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^justfile$/"],
      matchStrings: ['controller_tools_version := "(?<currentValue>v[^"]+)"'],
      datasourceTemplate: "github-releases",
      depNameTemplate: "kubernetes-sigs/controller-tools",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^justfile$/"],
      matchStrings: ['golangci_lint_version := "(?<currentValue>v[^"]+)"'],
      datasourceTemplate: "github-releases",
      depNameTemplate: "golangci/golangci-lint",
    },
    {
      // Must match golangci_lint_version in the justfile; same depName keeps both in one PR.
      customType: "regex",
      managerFilePatterns: ["/^\\.custom-gcl\\.yml$/"],
      matchStrings: ["version: (?<currentValue>v\\S+)"],
      datasourceTemplate: "github-releases",
      depNameTemplate: "golangci/golangci-lint",
    },
    {
      // Technitium image tag, pinned in the TechnitiumCluster type default and both generated
      // CRDs. The CRDs are matched directly rather than regenerated by a follow-up step, so one
      // Renovate PR is complete and verify-generated passes as-is. Same depName keeps these and
      // the test image below in one PR. The tag must be plain X.Y.Z (no "v"), which keeps the
      // match tight.
      customType: "regex",
      managerFilePatterns: [
        "/^api/v1alpha1/technitiumcluster_types\\.go$/",
        "/^config/crd/bases/dns\\.packet\\.fail_technitiumclusters\\.yaml$/",
        "/^charts/technitium-operator/templates/crds/dns\\.packet\\.fail_technitiumclusters\\.yaml$/",
      ],
      matchStrings: ["technitium/dns-server:(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      datasourceTemplate: "docker",
      depNameTemplate: "technitium/dns-server",
    },
    {
      // The shared test image. Only TechnitiumImage is matched: PreviousTechnitiumImage is the
      // starting point of the upgrade tests and must stay older, so it is bumped by hand.
      customType: "regex",
      managerFilePatterns: ["/^test/testimage/testimage\\.go$/"],
      matchStrings: ['const TechnitiumImage = "technitium/dns-server:(?<currentValue>\\d+\\.\\d+\\.\\d+)"'],
      datasourceTemplate: "docker",
      depNameTemplate: "technitium/dns-server",
    },
  ],
}
