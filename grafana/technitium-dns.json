          },
          "expr": "sum by (source) (technitium_dns_queries_by_source_last_hour{cluster=~\"$cluster\", node=~\"$node\"})",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Queries per node",
